# Generated by scripts/op.mjs from ops.json. Do not edit.
# Regenerate with: node scripts/op.mjs render

op := "node scripts/op.mjs"

# Install the pinned tools with mise.
install:
    {{op}} run install

# Run flint over every tracked file.
lint:
    {{op}} run lint

# Fix what flint can fix.
lint-fix:
    {{op}} run lint-fix

# Run the AI-slop gate.
aislop:
    {{op}} run aislop

# Scan the filesystem with Trivy.
security:
    {{op}} run security

# Scan git history for secrets with gitleaks.
secret-scan:
    {{op}} run secret-scan

# Run every test suite, including the agent-token scope tests.
test:
    {{op}} run test

# Run the offline agent-token scope tests.
test-agent-token:
    {{op}} run test-agent-token

# Run the suite with coverage and write coverage/lcov.info.
coverage:
    {{op}} run coverage

# Run the agent-access enforcement tests over the fixture catalog and the pre-push hook.
test-agent-access:
    {{op}} run test-agent-access

# Check the cumulative agent-access contract and its generated ruleset policy.
test-agent-access-contract:
    {{op}} run test-agent-access-contract

# Run the all-checks aggregate workflow policy tests over local fixtures.
test-all-checks:
    {{op}} run test-all-checks

# Run local ruleset approval and explicit auto-merge setting tests.
test-ruleset-policy:
    {{op}} run test-ruleset-policy

# Run the patch-coverage matcher tests.
test-patch-coverage:
    {{op}} run test-patch-coverage

# Run the scripting conformance rule tests over fixtures.
test-scripting:
    {{op}} run test-scripting

# Run the subprocess windowsHide rule tests over fixtures and the check-standard and check-repo matrices.
test-subprocess:
    {{op}} run test-subprocess

# Run the process PATH discovery tests without launching discovered commands.
test-proc:
    {{op}} run test-proc

# Run the env convention rule tests over fixtures.
test-env:
    {{op}} run test-env

# Run the required-check rule tests over fixtures and the check-standard and check-repo matrices.
test-required:
    {{op}} run test-required

# Run the focused cross-platform regression on the host OS.
test-portable:
    {{op}} run test-portable

# Run the pure repository-maintenance planner tests under a host Python 3.10 or newer.
test-repo-maintenance:
    {{op}} run test-repo-maintenance

# Run the planner dispatcher environment regression checks without launching an interpreter.
test-repo-maintenance-dispatcher:
    {{op}} run test-repo-maintenance-dispatcher

# Run the local CI mirror: lint, test, aislop, security, and secret scan.
verify:
    {{op}} run verify

# Prune remote-tracking refs and delete local branches merged into main.
prune:
    {{op}} run prune

# Validate the operation manifest, recipes, twins, and generated artifacts.
check:
    {{op}} run check

# Check one repository against the standard and print a matrix.
check-standard *args:
    {{op}} run check-standard {{args}}

# Check one repository against the standard, applying the exception file.
check-repo *args:
    {{op}} run check-repo {{args}}

# Audit the scripting conformance of every repository in a directory and print one matrix.
audit-fleet *args:
    {{op}} run audit-fleet {{args}}

# Resolve a repository's agent access level and capabilities.
agent-access *args:
    {{op}} run agent-access {{args}}

# Check the declared level against both live main rulesets.
check-agent-access *args:
    {{op}} run check-agent-access {{args}}

# Create the fleet agent GitHub App from the manifest and capture its credentials.
create-agent-app *args:
    {{op}} run create-agent-app {{args}}

# Mint a short-lived installation token for a fleet repository.
agent-token *args:
    {{op}} run agent-token {{args}}

# Fail when the changed lines are not covered enough.
patch-coverage *args:
    {{op}} run patch-coverage {{args}}

# Converge repository settings, the owner topic, and public-repo security.
apply-settings *args:
    {{op}} run apply-settings {{args}}

# Apply the ruleset JSON to a repository.
apply-rulesets *args:
    {{op}} run apply-rulesets {{args}}

# Print a hard-protection or approval-only ruleset payload for a repository level.
ruleset-payload *args:
    {{op}} run ruleset-payload {{args}}
